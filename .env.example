# GAMMAX V5 PRO — UNIVERSAL DHAN DATA GATEWAY
NODE_ENV=production
PORT=10000
HOST=0.0.0.0
CORS_ORIGIN=*

# DHAN AUTH — automatic TOTP, no daily manual access token
DHAN_CLIENT_ID=
DHAN_PIN=
DHAN_TOTP_SECRET=
DHAN_AUTH_MODE=TOTP
DHAN_AUTO_RENEW_TOKEN=true
DHAN_TOKEN_REFRESH_BEFORE_MIN=30
AUTH_REFRESH_INTERVAL_MS=60000
DHAN_API_BASE_URL=https://api.dhan.co/v2
# Do not add DHAN_ACCESS_TOKEN. Backend creates it through TOTP.

# DHAN FEEDS
DHAN_LIVE_FEED_URL=wss://api-feed.dhan.co
DHAN_20_DEPTH_URL=wss://depth-api-feed.dhan.co/twentydepth
DHAN_200_DEPTH_URL=wss://full-depth-api.dhan.co/twohundreddepth
ENABLE_LIVE_FEED=true
ENABLE_20_DEPTH=true
ENABLE_200_DEPTH=true
ENABLE_MARKET_QUOTE=true
ENABLE_OPTION_CHAIN=true
ENABLE_HISTORICAL_DATA=true
ENABLE_INTRADAY_HISTORY=true
ENABLE_EXPIRED_OPTIONS_HISTORY=true
AUTO_SUBSCRIBE_INDICES=true
AUTO_SUBSCRIBE_OPTIONS=true
AUTO_SUBSCRIBE_FUTURES=false

# INDEX MAPPING
DEFAULT_INDEX=NIFTY
DEFAULT_EXCHANGE=NSE
NIFTY_SECURITY_ID=13
NIFTY_SEGMENT=IDX_I
NIFTY_OPTION_SEGMENT=NSE_FNO
BANKNIFTY_SECURITY_ID=25
BANKNIFTY_SEGMENT=IDX_I
BANKNIFTY_OPTION_SEGMENT=NSE_FNO
FINNIFTY_SECURITY_ID=27
FINNIFTY_SEGMENT=IDX_I
FINNIFTY_OPTION_SEGMENT=NSE_FNO
MIDCPNIFTY_SECURITY_ID=442
MIDCPNIFTY_SEGMENT=IDX_I
MIDCPNIFTY_OPTION_SEGMENT=NSE_FNO
SENSEX_SECURITY_ID=51
SENSEX_SEGMENT=IDX_I
SENSEX_OPTION_SEGMENT=BSE_FNO

# CAPACITY / DEPTH
MAX_CLIENTS=100
MAX_SUBSCRIPTIONS=5000
MAX_DHAN_WS_CONNECTIONS=5
MAX_INSTRUMENTS_PER_WS=5000
MAX_INSTRUMENTS_PER_MESSAGE=100
MAX_TICKS_PER_INSTRUMENT=3000
MAX_CANDLES_PER_INSTRUMENT=2000
TICK_BUFFER_SIZE=10000
MAX_HISTORY_RECORDS=50000
DEPTH_MAX_INSTRUMENTS=50
DEPTH_LEVELS_20=20
DEPTH_LEVELS_200=200
DEPTH_REFRESH_MS=1000
DEPTH_CACHE_TTL_MS=1000

# DATA QUALITY / RECONNECT
TICK_STALE_MS=15000
STALE_AFTER_MS=5000
LIVE_HISTORY_REFRESH_MS=60000
RECONNECT_DELAY_MS=3000
MAX_RECONNECT_DELAY_MS=30000
HEARTBEAT_INTERVAL_MS=10000

# CANDLE ENGINE
ENABLE_CANDLE_ENGINE=true
CANDLE_TIMEFRAME_MS=30000
SUPPORTED_TIMEFRAMES=30000,60000,180000,300000,900000,1800000,3600000
CANDLE_SOURCE=TICKS
CANDLE_FINALIZE_ON_INTERVAL=true
CANDLE_CACHE_LIMIT=2000
HISTORY_CACHE_TTL_MS=30000

# OPTION CHAIN / GREEKS
ENABLE_OI=true
ENABLE_CHANGE_IN_OI=true
ENABLE_VOLUME=true
ENABLE_IV=true
ENABLE_DELTA=true
ENABLE_GAMMA=true
ENABLE_THETA=true
ENABLE_VEGA=true
ENABLE_HIDDEN_GREEKS=true
ENABLE_BID_ASK=true
ENABLE_PCR=true
ENABLE_MAX_PAIN=true
ENABLE_OI_WALLS=true
ENABLE_ATM_STRADDLE=true
OPTION_CHAIN_REFRESH_MS=3200
OPTION_CHAIN_STRIKE_RANGE=30
OPTION_CHAIN_STRIKE_INTERVAL=50
OPTION_CHAIN_CACHE_TTL_MS=3000
GREEKS_CALCULATION_ENABLED=true
HIDDEN_GREEKS_CALCULATION_ENABLED=true

# PRO TRADER DATA APIs
ENABLE_TECHNICAL_DATA_API=true
ENABLE_MARKET_MOVERS_API=true
ENABLE_NEWS_HEADLINES_API=true
ENABLE_COMPANY_INFO_API=false
ENABLE_CAS_LIVE_FEED=false
TECHNICAL_DATA_REFRESH_MS=5000
MARKET_MOVERS_REFRESH_MS=15000
NEWS_REFRESH_MS=60000
CAS_REFRESH_MS=60000

# ADAPTIVE PIPELINES / CACHE
ENABLE_ADAPTIVE_PIPELINES=true
ENABLE_TICK_PIPELINE=true
ENABLE_QUOTE_PIPELINE=true
ENABLE_CANDLE_PIPELINE=true
ENABLE_SNAPSHOT_PIPELINE=true
DEFAULT_DELIVERY_MODE=candle
DEFAULT_PUSH_INTERVAL_MS=1000
MIN_PUSH_INTERVAL_MS=250
MAX_PUSH_INTERVAL_MS=10000
ENABLE_CLIENT_THROTTLING=true
ENABLE_BACKPRESSURE=true
ENABLE_MESSAGE_COMPRESSION=true
ENABLE_PER_CLIENT_SUBSCRIPTIONS=true
ENABLE_CLIENT_AUTO_RECOVERY=true
ENABLE_RESPONSE_CACHE=true
MAX_CACHE_ITEMS=100000
QUOTE_CACHE_TTL_MS=1000
OPTION_CACHE_TTL_MS=3000

# PUSH — generate a fresh VAPID pair; do not reuse the key pasted in chat
PUSH_ENABLED=true
VAPID_SUBJECT=mailto:your-email@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# AI (optional; keep disabled until an API key is configured)
AI_ASSISTANT_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6
AI_MONITORING_ENABLED=false
AI_DATA_QUALITY_CHECK=true
AI_FEED_HEALTH_CHECK=true
AI_ANALYTICS_ENABLED=false

# TRADING EXECUTION — DATA ONLY / DISABLED BY DEFAULT
ENABLE_TRADING_API=false
ENABLE_LIVE_ORDER_EXECUTION=false
ENABLE_PAPER_TRADING=false
ENABLE_ORDER_STATUS_TRACKING=false
ENABLE_DUPLICATE_ORDER_GUARD=true
ENABLE_RISK_ENGINE=false
MAX_CAPITAL_PER_TRADE=50000
MAX_DAILY_LOSS=2000
ORDER_KILL_SWITCH=true

# LOGGING
LOG_LEVEL=info
ENABLE_REQUEST_LOGS=true
ENABLE_WS_LOGS=true
ENABLE_ERROR_LOGS=true
ENABLE_PERFORMANCE_METRICS=true
ENABLE_HEALTH_MONITOR=true

# Active/standby deployment role. Primary=false; backup=true.
FAILOVER_STANDBY=true
